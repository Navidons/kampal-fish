# Gmail SMTP Configuration
# Your Gmail address
GMAIL_USER=your-email@gmail.com

# Your Gmail App Password (not your regular password)
# Generate this in Google Account settings > Security > App passwords
GMAIL_APP_PASSWORD=your-16-character-app-password

# Admin email address (where notifications will be sent)
# If not provided, will use GMAIL_USER
ADMIN_EMAIL=admin@kampalafriedfish.com

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here
